# Copy to .env, or run `python scripts/init_env.py` to create .env with generated secrets.
# Values marked CHANGE_ME must be replaced before the stack is used for real.

# --- Database -------------------------------------------------------------------------------
POSTGRES_USER=planner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=planner

# --- Where the browser reaches the application ------------------------------------------------
# https:// here switches the session cookies to Secure. Behind a TLS proxy use its public URL.
PUBLIC_BASE_URL=http://localhost:8080
# Where the containers publish their ports on the host. Keep 127.0.0.1 unless a TLS proxy fronts
# them. HTTP_PORT is the web interface, API_PORT the API (with docker/docker-compose.dev.yml the
# proxy listens on HTTP_PORT instead and the API is only reachable through it).
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
API_PORT=8081
# Comma-separated origins of third-party browser clients; empty for the bundled web interface.
CORS_ORIGINS=
# Language of the sign-in page for browsers that ask for none we ship (en, de).
DEFAULT_LOCALE=en

# --- Sign-in ----------------------------------------------------------------------------------
AUTH_LOCAL_ENABLED=true
AUTH_OIDC_ENABLED=false
SESSION_TTL_HOURS=12
# The first administrator, created on the first start. A new password is demanded at first sign-in.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- OpenID Connect (only when AUTH_OIDC_ENABLED=true) ----------------------------------------
OIDC_ISSUER=
# Where the API reaches the provider, if that differs from the public issuer (container network).
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=resource-planner
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_ROLES_SOURCE=access_token
OIDC_USERNAME_CLAIM=preferred_username
# Audiences accepted on bearer tokens of API clients; empty switches bearer validation off.
OIDC_API_AUDIENCES=

# --- Development Keycloak (docker/docker-compose.dev.yml, profile dev-keycloak) ---------------
# `docker compose -f docker-compose.yml -f docker/docker-compose.dev.yml --profile dev-keycloak up -d`
# starts a throw-away Keycloak with the realm "planner" from docker/keycloak/ at
# http://localhost:8180 (admin console: KEYCLOAK_ADMIN below), and a proxy that serves the
# interface and the API on one address. It has the demo accounts admin-demo, planner-demo and
# viewer-demo, all with KEYCLOAK_DEMO_PASSWORD. To sign in through it, set in the section above:
#   AUTH_OIDC_ENABLED=true
#   OIDC_ISSUER=http://localhost:8180/realms/planner
#   OIDC_DISCOVERY_URL=http://keycloak:8080/realms/planner/.well-known/openid-configuration
#   OIDC_CLIENT_ID=resource-planner
#   OIDC_CLIENT_SECRET=<a long random value; the realm is imported with the same one>
#   OIDC_API_AUDIENCES=resource-planner
# The realm is only imported into an empty Keycloak: after changing a value here, remove the
# container (add `rm -sf keycloak` to the command above) before starting it again.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_DEMO_PASSWORD=CHANGE_ME
# Secret of the client the directory import uses to read users and groups.
KEYCLOAK_SYNC_CLIENT_SECRET=CHANGE_ME

# --- Secrets at rest --------------------------------------------------------------------------
# Encrypts the secrets stored with integrations (a Fernet key: 32 random bytes, url-safe base64).
APP_ENCRYPTION_KEY=CHANGE_ME

# --- Integrations -----------------------------------------------------------------------------
# Runs the scheduled syncs of integrations. Keep it on for exactly one API instance.
SCHEDULER_ENABLED=true
# Hours after which a scheduled run reads the whole source again, when the provider can read only
# what changed (Jira). Only a complete read closes the tasks that disappeared from the source.
SYNC_FULL_INTERVAL_HOURS=24

# --- Operation --------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Loads demo data with `planner-api seed-demo`. Leave off in production.
ENABLE_DEMO_SEED=false
IMAGE_TAG=local
