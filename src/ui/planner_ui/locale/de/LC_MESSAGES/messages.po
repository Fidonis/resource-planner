#: provider_texts.py
msgid "CSV file (absences)"
msgstr "CSV-Datei (Abwesenheiten)"

#: provider_texts.py
msgid "File"
msgstr "Datei"

#: provider_texts.py
msgid "Path of the CSV file below the import directory, for example absences.csv."
msgstr "Pfad der CSV-Datei unterhalb des Importverzeichnisses, zum Beispiel absences.csv."

#: provider_texts.py
msgid "CSV file (people)"
msgstr "CSV-Datei (Personen)"

#: provider_texts.py
msgid "Path of the CSV file below the import directory, for example people.csv."
msgstr "Pfad der CSV-Datei unterhalb des Importverzeichnisses, zum Beispiel people.csv."

#: provider_texts.py
msgid "Keycloak"
msgstr "Keycloak"

#: provider_texts.py
msgid "Keycloak URL"
msgstr "Keycloak-Adresse"

#: provider_texts.py
msgid "Address of Keycloak as the API reaches it, for example http://keycloak:8080 (without /realms/...)."
msgstr ""
"Adresse von Keycloak, wie die API sie erreicht, zum Beispiel http://keycloak:8080 (ohne "
"/realms/...)."

#: provider_texts.py
msgid "Realm"
msgstr "Realm"

#: provider_texts.py
msgid "Client ID"
msgstr "Client-ID"

#: provider_texts.py
msgid "Client with a service account that may view users and query groups."
msgstr "Client mit einem Service-Konto, das Benutzer ansehen und Gruppen abfragen darf."

#: provider_texts.py
msgid "Client secret"
msgstr "Client-Geheimnis"

#: provider_texts.py
msgid "Verify the certificate"
msgstr "Zertifikat prüfen"

#: provider_texts.py
msgid "Switch off only for tests."
msgstr "Nur für Tests ausschalten."

#: provider_texts.py
msgid "Realm roles to read"
msgstr "Zu lesende Realm-Rollen"

#: provider_texts.py
msgid ""
"One per line. Only the holders of these roles are told apart by role, for the mapping's 'include "
"roles'. Needs the right view-realm."
msgstr ""
"Eine pro Zeile. Nur die Inhaber dieser Rollen werden für „Rollen einbeziehen“ der Zuordnung nach "
"Rolle unterschieden. Braucht das Recht view-realm."

#: provider_texts.py
msgid "Page size"
msgstr "Seitengröße"

#: provider_texts.py
msgid "CSV file (tasks)"
msgstr "CSV-Datei (Aufgaben)"

#: provider_texts.py
msgid "Path of the CSV file below the import directory, for example tasks.csv."
msgstr "Pfad der CSV-Datei unterhalb des Importverzeichnisses, zum Beispiel tasks.csv."

#: provider_texts.py
msgid "Effort strategy"
msgstr "Aufwandsstrategie"

#: provider_texts.py
msgid ""
"EVEN_SPLIT shares the estimate over the labels that name a skill; LABEL_ENCODED reads the effort "
"from labels such as be-3; CUSTOM_FIELDS reads one field per skill; MANUAL imports no effort."
msgstr ""
"EVEN_SPLIT verteilt die Schätzung gleichmäßig auf die Labels, die eine Fähigkeit nennen; "
"LABEL_ENCODED liest den Aufwand aus Labels wie be-3; CUSTOM_FIELDS liest ein Feld je Fähigkeit; "
"MANUAL übernimmt keinen Aufwand."

#: provider_texts.py
msgid "Unit factor"
msgstr "Umrechnungsfaktor"

#: provider_texts.py
msgid "Person-days per unit of the estimate (story points x factor, hours / 8 is 0.125)."
msgstr "Personentage je Einheit der Schätzung (Story Points x Faktor; Stunden / 8 ergibt 0,125)."

#: provider_texts.py
msgid "Label pattern"
msgstr "Label-Muster"

#: provider_texts.py
msgid "LABEL_ENCODED: a regular expression with the groups 'skill' and 'effort'."
msgstr "LABEL_ENCODED: ein regulärer Ausdruck mit den Gruppen „skill“ und „effort“."

#: provider_texts.py
msgid "Label skills"
msgstr "Label-Fähigkeiten"

#: provider_texts.py
msgid "Label to skill key, when they differ. Matching ignores case."
msgstr "Label auf Fähigkeitsschlüssel, wenn sie sich unterscheiden. Groß- und Kleinschreibung zählt nicht."

#: provider_texts.py
msgid "Unknown labels"
msgstr "Unbekannte Labels"

#: provider_texts.py
msgid "What to do with a label that names no skill."
msgstr "Was mit einem Label geschieht, das keine Fähigkeit nennt."

#: provider_texts.py
msgid "Custom field skills"
msgstr "Fähigkeiten der Zusatzfelder"

#: provider_texts.py
msgid "CUSTOM_FIELDS: skill key to the name of its field."
msgstr "CUSTOM_FIELDS: Fähigkeitsschlüssel auf den Namen seines Feldes."

#: provider_texts.py
msgid "Status map"
msgstr "Statuszuordnung"

#: provider_texts.py
msgid "State of the source to open, done or cancelled. The usual names are known already."
msgstr "Zustand der Quelle auf open, done oder cancelled. Die üblichen Namen sind schon bekannt."

#: provider_texts.py
msgid "Team map"
msgstr "Teamzuordnung"

#: provider_texts.py
msgid "Team hint of the source (project, component) to team."
msgstr "Team-Hinweis der Quelle (Projekt, Komponente) auf Team."

#: provider_texts.py
msgid "Missing"
msgstr "Fehlende Einträge"

#: provider_texts.py
msgid ""
"CLOSE cancels open tasks that the source no longer returns; KEEP leaves them. Only a complete "
"read of the source can tell."
msgstr ""
"CLOSE storniert offene Aufgaben, die die Quelle nicht mehr liefert; KEEP lässt sie unverändert. "
"Das lässt sich nur nach einem vollständigen Lesen der Quelle sagen."

#: provider_texts.py
msgid "Include groups"
msgstr "Gruppen einbeziehen"

#: provider_texts.py
msgid "Import only people in one of these groups. Empty: everybody."
msgstr "Nur Personen aus einer dieser Gruppen übernehmen. Leer: alle."

#: provider_texts.py
msgid "Include roles"
msgstr "Rollen einbeziehen"

#: provider_texts.py
msgid "Import also people with one of these roles. Empty: no filter by role."
msgstr "Auch Personen mit einer dieser Rollen übernehmen. Leer: kein Filter nach Rolle."

#: provider_texts.py
msgid "Group teams"
msgstr "Gruppen und Teams"

#: provider_texts.py
msgid ""
"Group=Team, one per line, the most important first. A person gets the team of the first of their "
"groups that is listed. Without '=' the team has the group's name."
msgstr ""
"Gruppe=Team, eine pro Zeile, die wichtigste zuerst. Eine Person erhält das Team der ersten ihrer "
"Gruppen, die aufgeführt ist. Ohne „=“ heißt das Team wie die Gruppe."

#: provider_texts.py
msgid "Create teams"
msgstr "Teams anlegen"

#: provider_texts.py
msgid "Create a team that a listed group names but that is missing."
msgstr "Ein Team anlegen, das eine aufgeführte Gruppe nennt und das noch fehlt."

#: provider_texts.py
msgid "Default team"
msgstr "Standardteam"

#: provider_texts.py
msgid ""
"Team of the people without a listed group. It must exist already. Without it these people are "
"reported and not imported."
msgstr ""
"Team der Personen ohne aufgeführte Gruppe. Es muss schon existieren. Ohne Angabe werden diese "
"Personen gemeldet und nicht übernommen."

#: provider_texts.py
msgid "Group skills"
msgstr "Gruppen und Fähigkeiten"

#: provider_texts.py
msgid ""
"Group=Skill, one per line. People in the group get the skill added; the import never takes a "
"skill away."
msgstr ""
"Gruppe=Fähigkeit, eine pro Zeile. Personen der Gruppe erhalten die Fähigkeit dazu; der Import "
"nimmt nie eine Fähigkeit weg."

#: provider_texts.py
msgid "Default allocation percent"
msgstr "Standardverfügbarkeit in Prozent"

#: provider_texts.py
msgid "Share for new members. Default: the setting."
msgstr "Anteil für neue Mitglieder. Standard: die Einstellung."

#: provider_texts.py
msgid "CLOSE deactivates members that the directory no longer returns; KEEP leaves them."
msgstr "CLOSE deaktiviert Mitglieder, die das Verzeichnis nicht mehr liefert; KEEP lässt sie unverändert."

#: provider_texts.py
msgid "Type map"
msgstr "Typzuordnung"

#: provider_texts.py
msgid "Type code of the source to the key of an absence type."
msgstr "Typ-Code der Quelle auf den Schlüssel einer Abwesenheitsart."

#: provider_texts.py
msgid "Lookback days"
msgstr "Tage zurück"

#: provider_texts.py
msgid "Days before today to read."
msgstr "Wie viele Tage vor heute gelesen werden."

#: provider_texts.py
msgid "Lookahead days"
msgstr "Tage voraus"

#: provider_texts.py
msgid "Days after today."
msgstr "Wie viele Tage nach heute."

#: provider_texts.py
msgid ""
"CLOSE removes absences of this integration that the source no longer reports within the days "
"read; KEEP leaves them."
msgstr ""
"CLOSE entfernt Abwesenheiten dieser Anbindung, die die Quelle innerhalb der gelesenen Tage nicht "
"mehr meldet; KEEP lässt sie unverändert."

